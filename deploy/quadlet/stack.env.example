# In-stack addresses and credentials for the Quadlet units. Install as
# /etc/termoso/stack.env (mode 0600). The server settings themselves live in
# /etc/termoso/env — a filled-in copy of deploy/.env.example.
#
# Change the two passwords in BOTH places they appear.

POSTGRES_USER=termoso
POSTGRES_DB=termoso
POSTGRES_PASSWORD=change-me

RUSTFS_ACCESS_KEY=termoso
RUSTFS_SECRET_KEY=change-me-too

TERMOSO_BIND=0.0.0.0:8080
TERMOSO_DATABASE_URL=postgres://termoso:change-me@termoso-postgres:5432/termoso
TERMOSO_REDIS_URL=redis://termoso-redis:6379
TERMOSO_S3__ENDPOINT=http://termoso-rustfs:9000
TERMOSO_S3__BUCKET=termoso-logs
TERMOSO_S3__ACCESS_KEY=termoso
TERMOSO_S3__SECRET_KEY=change-me-too
TERMOSO_S3__REGION=us-east-1
TERMOSO_TRUST_PROXY=true
