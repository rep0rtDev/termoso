# ── required ────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts server-side secrets at rest.
# Losing it makes the database unusable. Generate: openssl rand -base64 32
TERMOSO_MASTER_KEY=

# Public URL clients and e-mails use to reach the API.
TERMOSO_PUBLIC_URL=https://api.termoso.example.com
# Web cabinet URL (links in e-mails). Defaults to TERMOSO_PUBLIC_URL.
TERMOSO_WEB_URL=https://app.termoso.example.com

POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=termoso
MINIO_ROOT_PASSWORD=change-me-too

# Public hostname clients use for pre-signed log uploads (proxy → minio:9000).
TERMOSO_S3__PUBLIC_ENDPOINT=https://s3.termoso.example.com

# ── recommended ─────────────────────────────────────────────────────────────
# Comma-separated e-mails that become administrators on sign-up / login.
TERMOSO_ADMIN_EMAILS=you@example.com
TERMOSO_SERVER_NAME=Termoso
# Comma-separated browser origins allowed to call the API (web cabinet).
TERMOSO_CORS_ORIGINS=https://app.termoso.example.com

# SMTP (e-mail verification, device approval, e-mail MFA). Omit to run without e-mail.
TERMOSO_SMTP__HOST=smtp.example.com
TERMOSO_SMTP__PORT=587
TERMOSO_SMTP__USERNAME=
TERMOSO_SMTP__PASSWORD=
TERMOSO_SMTP__SECURITY=starttls
TERMOSO_SMTP__FROM=Termoso <no-reply@termoso.example.com>

# WebAuthn / passkeys (optional).
TERMOSO_WEBAUTHN__RP_ID=termoso.example.com
TERMOSO_WEBAUTHN__ORIGINS=https://app.termoso.example.com,tauri://localhost,http://tauri.localhost

# ── optional ────────────────────────────────────────────────────────────────
# SSO (OIDC). Presets: google, microsoft, github. Any other slug needs ISSUER.
#TERMOSO_SSO__GOOGLE__CLIENT_ID=
#TERMOSO_SSO__GOOGLE__CLIENT_SECRET=
#TERMOSO_SSO__GITHUB__CLIENT_ID=
#TERMOSO_SSO__GITHUB__CLIENT_SECRET=
#TERMOSO_SSO__COMPANY__NAME=Company SSO
#TERMOSO_SSO__COMPANY__ISSUER=https://login.example.com/realms/main
#TERMOSO_SSO__COMPANY__CLIENT_ID=
#TERMOSO_SSO__COMPANY__CLIENT_SECRET=
#TERMOSO_SSO__COMPANY__ALLOWED_DOMAINS=example.com

# Operator-only Prometheus metrics on a separate private listener. Off by default.
#TERMOSO_METRICS__ENABLED=true
#TERMOSO_METRICS__BIND=127.0.0.1:9090

TERMOSO_LOG=info,sqlx=warn
TERMOSO_LOG_FORMAT=json
TERMOSO_SWAGGER_UI=false
TERMOSO_VERSION=latest
TERMOSO_PORT=8080
# Prefix for all Redis keys/channels (only needed if deployments share one Redis).
#TERMOSO_REDIS_PREFIX=termoso:
