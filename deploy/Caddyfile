# Reverse proxy for the `proxy` profile of docker-compose.yml.
# Certificates come from Let's Encrypt automatically; both hostnames must
# point at this machine. Caddy sets X-Forwarded-For, which the API honours
# because TERMOSO_TRUST_PROXY=true in the stack.

{
	email {$ACME_EMAIL}
}

# API + web cabinet + WebSocket, one origin. With the landing on its own
# domain (TERMOSO_LANDING_URL) list both, comma-separated:
#   TERMOSO_DOMAIN=app.example.com, example.com
# The server routes by Host; the same goes for TERMOSO_SSHID_URL.
{$TERMOSO_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}

# Pre-signed session-log uploads/downloads (TERMOSO_S3__PUBLIC_ENDPOINT).
{$TERMOSO_S3_DOMAIN} {
	reverse_proxy minio:9000
}
