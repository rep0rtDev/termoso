root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,kt,kts,swift,py,sh,sql,gradle}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{container,network,volume,service}]
indent_style = tab

[Caddyfile]
indent_style = tab
